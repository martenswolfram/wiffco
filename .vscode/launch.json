{
    // .vscode/launch.json
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-s",
                "-v",
                // "tests",
                // "--ignore=tests/test_optimization.py",
                "tests/test_plant_model.py",
            ],
            "justMyCode": true,
        },
    ]
}