{
    // .vscode/launch.json
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Current File",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}" 
            }
        },
        {
            "name": "Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-s",
                "-v",
                "-o",
                "log_cli=true",
                "--log-cli-level=DEBUG",
                "tests",
                // "tests/test_statistics.py",
                // "tests/test_plant_model.py",
                // "tests/test_control_policy.py",
                // "tests/test_aggregation.py",
                // "tests/test_metrics_accumulation.py",
                // "tests/test_constraint.py",
                // "tests/test_metrics_reduction.py",
                // "tests/test_optimization.py",
            ],
            "justMyCode": true,
        },
    ]
}