{
    "input_symbol_mappings": {
        "control": {
            "power_regulation": "pr"
        },
        "ambient": {
            "wind_speed_mps": "ws"
        }
    },
    "output_functions": {
        "model_output": {
            "electrical_power": "pr**0.5 * (ws / 10)**2",
            "damage_rate": "pr**2 * (ws / 10)**2"
        }
    }
}