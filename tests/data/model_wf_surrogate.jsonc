{
    "name": "wf_surrogate_model",
    "model_type": "wind_farm_surrogate",
    "floris_config_file": "tests/data/floris_default_inputs.yaml",
    "wind_farm_layout_file": "tests/data/la_haute_borne/wf_layout.csv", // optional
    "ambient_variables": ["wind_speed", "wind_direction", "turbulence_intensity"],
    "control_variables": ["yaw_angle"],
    "output_variables": ["electrical_power", "damage_rate"],
    "damage_components": ["blade_root", "shaft", "tower_base", "yaw_bearings"]
}